# Token lấy từ Zalo Bot Manager khi tạo bot
ZALO_BOT_TOKEN=
# Chuỗi bí mật tự đặt (8-256 ký tự), gửi kèm khi setWebhook, Zalo trả lại ở header X-Bot-Api-Secret-Token
ZALO_WEBHOOK_SECRET=
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
# Số điện thoại/Zalo của nhân viên để bot chuyển khách khi không trả lời được
HOTLINE=0385.908.114
