# Token lấy từ Zalo Bot Creator khi tạo bot
ZALO_BOT_TOKEN=
# Chuỗi bí mật tự đặt (8-256 ký tự), chỉ dùng cho chế độ webhook
ZALO_WEBHOOK_SECRET=

# Chọn gemini (miễn phí) hoặc anthropic (Claude, tính phí)
LLM_PROVIDER=gemini
# Key miễn phí lấy ở aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Chỉ cần khi LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

HOTLINE=0385.908.114
